{
  "name": "lyrics-overlay",
  "version": "0.1.7",
  "private": true,
  "description": "Synced lyrics floating on top of your desktop for whatever is playing.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "author": "AhPlace2",
  "license": "AGPL-3.0-or-later",
  "build": {
    "appId": "com.ahplace2.lyricsoverlay",
    "productName": "Lyrics Overlay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/nowplaying.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyrics Overlay",
      "runAfterFinish": true,
      "artifactName": "Lyrics-Overlay-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US",
      "en-GB",
      "de"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "koffi": "3.3.4"
  }
}
